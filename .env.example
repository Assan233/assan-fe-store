# Local frontend dev server proxy target.
VITE_API_PROXY_TARGET=http://localhost:8080

# Compose settings: use SECURE_COOKIES=false only for local HTTP testing.
BIND_ADDRESS=127.0.0.1
HOST_PORT=28080
API_HOST_PORT=29090
SECURE_COOKIES=true

# Generate once: openssl rand -base64 32
# Keep the value stable across redeployments to decrypt saved music credentials.
MUSIC_CREDENTIAL_KEY=

# Build-time Go module mirror; set to an HTTPS proxy reachable from the NAS if proxy.golang.org times out.
# GO_MODULE_PROXY=https://goproxy.cn
